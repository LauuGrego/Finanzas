# ==============================================================================
# CONFIGURACIÓN GENERAL (Agenda Financiera) - EJEMPLO
# Copiá este archivo como .env y completá tus valores
# ==============================================================================

# Base de datos PostgreSQL
# En desarrollo (Docker): postgresql+psycopg://finanzas:finanzas@127.0.0.1:5434/finanzas
# En producción (Supabase): connection string del pooler (puerto 5432)
DATABASE_URL=postgresql+psycopg://finanzas:finanzas@127.0.0.1:5434/finanzas

# Seguridad y autenticación
# Dejar vacío en desarrollo para entrar directo sin login
FINANZAS_PASSWORD=
FINANZAS_USER=lautaro
FINANZAS_SESSION_DAYS=30

# CORS (orígenes del frontend permitidos, separados por coma)
FINANZAS_CORS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# RECORDATORIOS POR CORREO (SMTP / Gmail)
# ==============================================================================

# Servidor SMTP (por defecto Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Tu cuenta de correo remitente
SMTP_USER=tu-correo@gmail.com

# Contraseña de aplicación de Google (16 caracteres)
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Correo donde recibirás las alertas (si queda vacío usa SMTP_USER)
NOTIFICATION_EMAIL=tu-correo@gmail.com

# Clave secreta opcional para invocar el endpoint de recordatorios desde UptimeRobot o cron
CRON_SECRET=
